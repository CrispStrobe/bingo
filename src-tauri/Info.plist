<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- No cryptography beyond the OS's own TLS: skips the export-compliance
         question on every single upload. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSCameraUsageDescription</key>
    <string>Bingo Party uses the camera only when you choose to verify the QR code on a printed ticket.</string>
</dict>
</plist>
