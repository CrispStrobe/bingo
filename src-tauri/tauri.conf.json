{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bingo Party",
  "version": "1.0.0",
  "identifier": "com.crispstrobe.bingoparty",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bingo Party",
        "width": 1280,
        "height": 880,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "75-ball bingo for three players on one screen",
    "longDescription": "Bingo Party is a 75-ball bingo game for three players sharing one screen. Call a ball, everyone daubs their own card, and the first line wins the round.",
    "copyright": "© 2026 Christian Strobele",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
