{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrispBingo",
  "version": "1.0.0",
  "identifier": "com.crispstrobe.bingoparty",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CrispBingo",
        "width": 1280,
        "height": 880,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Bingo and Italian Tombola for up to eight players",
    "longDescription": "CrispBingo brings 75-ball Bingo, 90-ball Bingo and Italian Tombola to one screen or local Wi-Fi, with multiple tickets, printable cards and verified paper claims.",
    "copyright": "© 2026 Christian Strobele",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
