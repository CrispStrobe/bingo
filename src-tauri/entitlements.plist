<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Required even for a game that talks to nothing. Inside the App Sandbox
         WebKit's networking process loads every WKWebView resource, including
         the app's own custom scheme; without this the window renders nothing
         at all and nothing is logged anywhere. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- LAN play: the app listens on a port so other devices in the same
         wireless network can join. A sandboxed app cannot bind a socket
         without this. -->
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
